# Application Environmental Variables
STORE_PORT=3000
PANEL_PORT=3001
SHOP_PORT=3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Postgres Environmental Variables
DB_PORT=5432
DB_HOST=localhost
DB_NAME=store
DB_USERNAME=postgres
DB_PASSWORD=root

# MongoDB Environmental Variables
MONGO_URI=mongodb://mongo:root@localhost:27017
MONGO_DB=store

# Redis Environmental Variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# SMS IR Environmental Variables
SMS_IR_API_KEY=YOUR_API_KEY
SMS_IR_SEND_URL=https://api.sms.ir/v1/send/verify

# Email SMTP Environmental Variables
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_USER=YOUR_USERNAME
MAILTRAP_PASS=YOUR_PASSWORD

# JWT Environmental Variables
ACCESS_TOKEN_EXPIRE_TIME=1h
REFRESH_TOKEN_EXPIRE_TIME=7d
ACCESS_TOKEN_TIME_TO_LIVE=900
REFRESH_TOKEN_TIME_TO_LIVE=604800
TOKEN_SIGNING_ALGORITHM=EdDSA
TOKEN_ENCRYPTION_KEY_STORE=YOUR_TOKEN_ENCRYPTION_KEY
TOKEN_ENCRYPTION_KEY_PANEL=YOUR_TOKEN_ENCRYPTION_KEY
TOKEN_ENCRYPTION_KEY_SHOP=YOUR_TOKEN_ENCRYPTION_KE

# Liara Cloud Storage Variables
LIARA_S3_SECRET_KEY=YOUR_SECRET_KEY
LIARA_S3_ACCESS_KEY=YOUR_ACCESS_KEY
LIARA_S3_BUCKET_NAME=YOUR_BUCKET_NAME
LIARA_S3_ENDPOINT=https://storage.c2.liara.space
