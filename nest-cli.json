{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "compilerOptions": {
    "webpack": false
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database/mongo": {
      "type": "library",
      "root": "libs/database/mongo",
      "entryFile": "index",
      "sourceRoot": "libs/database/mongo/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/mongo/tsconfig.lib.json"
      }
    },
    "database/postgres": {
      "type": "library",
      "root": "libs/database/postgres",
      "entryFile": "index",
      "sourceRoot": "libs/database/postgres/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/postgres/tsconfig.lib.json"
      }
    },
    "module": {
      "type": "library",
      "root": "libs/module",
      "entryFile": "index",
      "sourceRoot": "libs/module/src",
      "compilerOptions": {
        "tsConfigPath": "libs/module/tsconfig.lib.json"
      }
    },
    "panel": {
      "type": "application",
      "root": "apps/panel",
      "entryFile": "main",
      "sourceRoot": "apps/panel/src",
      "compilerOptions": {
        "tsConfigPath": "apps/panel/tsconfig.app.json"
      }
    },
    "postgres": {
      "type": "library",
      "root": "libs/postgres",
      "entryFile": "index",
      "sourceRoot": "libs/postgres/src",
      "compilerOptions": {
        "tsConfigPath": "libs/postgres/tsconfig.lib.json"
      }
    },
    "security": {
      "type": "library",
      "root": "libs/security",
      "entryFile": "index",
      "sourceRoot": "libs/security/src",
      "compilerOptions": {
        "tsConfigPath": "libs/security/tsconfig.lib.json"
      }
    },
    "store": {
      "type": "application",
      "root": "apps/store",
      "entryFile": "main",
      "sourceRoot": "apps/store/src",
      "compilerOptions": {
        "tsConfigPath": "apps/store/tsconfig.app.json"
      }
    },
    "shop": {
      "type": "application",
      "root": "apps/shop",
      "entryFile": "main",
      "sourceRoot": "apps/shop/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shop/tsconfig.app.json"
      }
    }
  }
}
